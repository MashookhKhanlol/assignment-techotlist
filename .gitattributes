# Enforce LF line endings in the repo for cross-platform consistency.
# Git will convert to CRLF on Windows checkout automatically.
* text=auto eol=lf

# Explicitly binary — never mangle
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
