# Copy this file to .env and fill in your values
# Never commit .env to version control

# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use — haiku is cheapest, sonnet is more accurate
# Options: claude-haiku-4-5-20251001, claude-sonnet-4-5-20250929
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Allowed origins for CORS (frontend URL)
# Port 3002 is used locally to avoid conflict with other containers (3000=portfolio, 3001=n8n)
# Change to your subdomain in production
CORS_ORIGINS=http://localhost:3002
