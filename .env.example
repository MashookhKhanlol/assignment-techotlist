# Copy this file to .env and fill in your values
# Never commit .env to version control

# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use — haiku is cheapest, sonnet is more accurate
# Options: claude-haiku-3-5, claude-sonnet-4-5
CLAUDE_MODEL=claude-haiku-3-5

# Allowed origins for CORS (frontend URL)
# Local dev default — change to your subdomain in production
CORS_ORIGINS=http://localhost:3000
